<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>swcsinput - CSInput struct</Title>
      <Shortcut>swcsinput</Shortcut>
      <Description>The dispatch-thread-id struct repeated in every module that owns a compute shader</Description>
      <Author>SwRenderer</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Code Language="cpp"><![CDATA[public struct CSInput {
    public uint3 mDispatchThreadID : SV_DispatchThreadID;
};$end$]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
