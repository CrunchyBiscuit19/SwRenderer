<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>swnoblend - Disabled color blend attachment state</Title>
      <Shortcut>swnoblend</Shortcut>
      <Description>Full RGBA write mask with blending disabled, the default attachment state for opaque passes</Description>
      <Author>SwRenderer</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>name</ID>
          <ToolTip>Local variable name</ToolTip>
          <Default>noBlendState</Default>
        </Literal>
      </Declarations>
      <Code Language="cpp"><![CDATA[vk::PipelineColorBlendAttachmentState $name${};
$name$.colorWriteMask = vk::ColorComponentFlagBits::eR | vk::ColorComponentFlagBits::eG | vk::ColorComponentFlagBits::eB | vk::ColorComponentFlagBits::eA;
$name$.blendEnable = VK_FALSE;$end$]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
