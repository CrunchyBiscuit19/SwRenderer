<?xml version="1.0" encoding="utf-8"?>
<CodeSnippets xmlns="http://schemas.microsoft.com/VisualStudio/2005/CodeSnippet">
  <CodeSnippet Format="1.0.0">
    <Header>
      <Title>swcubemapimage - Cubemap image creation</Title>
      <Shortcut>swcubemapimage</Shortcut>
      <Description>SwImageFactory::createColorImageCubemap or createDepthImageCubemap call</Description>
      <Author>SwRenderer</Author>
      <SnippetTypes>
        <SnippetType>Expansion</SnippetType>
      </SnippetTypes>
    </Header>
    <Snippet>
      <Declarations>
        <Literal>
          <ID>member</ID>
          <ToolTip>Destination member expression</ToolTip>
          <Default>mResources.mCubemapImage</Default>
        </Literal>
        <Literal>
          <ID>kind</ID>
          <ToolTip>Color or Depth</ToolTip>
          <Default>Color</Default>
        </Literal>
        <Literal>
          <ID>name</ID>
          <ToolTip>Debug name string</ToolTip>
          <Default>"CubemapImage"</Default>
        </Literal>
        <Literal>
          <ID>format</ID>
          <ToolTip>vk::Format value</ToolTip>
          <Default>vk::Format::eR16G16B16A16Sfloat</Default>
        </Literal>
        <Literal>
          <ID>extent</ID>
          <ToolTip>vk::Extent3D expression, one face's width/height</ToolTip>
          <Default>faceExtent</Default>
        </Literal>
        <Literal>
          <ID>usage</ID>
          <ToolTip>vk::ImageUsageFlagBits value(s)</ToolTip>
          <Default>vk::ImageUsageFlagBits::eStorage | vk::ImageUsageFlagBits::eSampled</Default>
        </Literal>
        <Literal>
          <ID>mipmapped</ID>
          <ToolTip>Whether the image is mipmapped</ToolTip>
          <Default>true</Default>
        </Literal>
      </Declarations>
      <Code Language="cpp"><![CDATA[$member$ = SwImageFactory::create$kind$ImageCubemap($name$, $format$, $extent$, $usage$, $mipmapped$);$end$]]></Code>
    </Snippet>
  </CodeSnippet>
</CodeSnippets>
